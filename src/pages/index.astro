---
import "../styles/global.css";
import TornEdge from "../components/TornEdge.astro";
import {
  Menu, X, Award, MapPin, Flame, Coffee, Droplets, Milk, Mountain, Leaf, Sprout,
  Clock, TrainFront, Instagram, ArrowRight, ArrowLeft, Check, Scale, Timer, Navigation, CalendarCheck,
} from "lucide-astro";

/* ------------------------------------------------------------------
   MÖSSA · Coffee & Roots — cafetería de especialidad en Gràcia (Barcelona)
   Diseño: Webestatica. Las fotos se guardan en /public/images
   (ver descargar-imagenes.ps1).
------------------------------------------------------------------- */

const nav = [
  { href: "#carta", label: "Carta" },
  { href: "#origenes", label: "Orígenes" },
  { href: "#cafe-en-casa", label: "Café para casa" },
  { href: "#visitanos", label: "Visítanos" },
];

const horario = [
  { dias: "Lunes a viernes", horas: "8:00 – 19:00" },
  { dias: "Sábados, domingos y festivos", horas: "9:00 – 15:00" },
];

const especialidadIzq = [
  { icon: Award, title: "Más de 80 puntos SCA", text: "Solo servimos cafés que superan los 80 puntos sobre 100 en la escala de la Specialty Coffee Association, el umbral del café de especialidad." },
  { icon: MapPin, title: "Origen trazable", text: "Sabemos de qué país, región y productor viene cada lote. Te lo contamos en la barra y en cada bolsa." },
  { icon: Flame, title: "Tueste reciente", text: "Tostamos cada semana en lotes pequeños y servimos el café cuando ha reposado lo justo, entre 7 y 30 días después del tueste." },
];
const especialidadDer = [
  { icon: Coffee, title: "Molido al momento", text: "Molemos justo antes de cada extracción. El café molido empieza a perder aromas en pocos minutos." },
  { icon: Droplets, title: "Agua filtrada", text: "Un café de filtro es más de un 98 % agua. Usamos agua filtrada para que no tape los sabores del grano." },
  { icon: Milk, title: "Leche fresca y vegetal", text: "Leche fresca entera de granja catalana, y bebida de avena o de almendra sin coste extra." },
];

const tiles = [
  { img: "/images/tile-latte.webp", label: "Cafés con leche", href: "#carta", alt: "Café con leche y dibujo de espuma en taza sobre plato" },
  { img: "/images/tile-tueste.webp", label: "Tostado cada semana", href: "#origenes", alt: "Granos de café recién tostados enfriándose en la tostadora" },
  { img: "/images/tile-espresso.webp", label: "Espresso al momento", href: "#proceso", alt: "Espresso cayendo del portafiltro a la taza" },
];

type Producto = { cat: "cafe" | "brunch"; name: string; desc: string; price: string; img: string; tag?: string };
const productos: Producto[] = [
  { cat: "cafe", name: "Espresso", desc: "Etiopía Yirgacheffe. Floral y cítrico, con final de bergamota.", price: "1,90 €", img: "/images/espresso.webp" },
  { cat: "cafe", name: "Flat white", desc: "Doble espresso de Colombia con leche texturizada fina y sedosa.", price: "3,40 €", img: "/images/flat-white.webp", tag: "El más pedido" },
  { cat: "cafe", name: "Iced latte", desc: "Doble espresso, leche fría y hielo. Con avena, sin coste extra.", price: "4,20 €", img: "/images/iced-latte.webp" },
  { cat: "cafe", name: "Matcha latte con lavanda", desc: "Matcha japonés batido a mano, leche y sirope casero de lavanda.", price: "4,90 €", img: "/images/matcha-lavanda.webp", tag: "De temporada" },
  { cat: "brunch", name: "Tostada de aguacate", desc: "Pan de masa madre, aguacate, tomate cherry, rabanito y semillas.", price: "9,50 €", img: "/images/tostada-aguacate.webp", tag: "Vegana" },
  { cat: "brunch", name: "Tostada de guisantes y menta", desc: "Crema de guisantes, menta fresca y aceite de oliva virgen extra.", price: "8,50 €", img: "/images/tostada-guisantes.webp", tag: "Vegana" },
  { cat: "brunch", name: "Bowl de yogur y frutos rojos", desc: "Yogur griego, granola de la casa, frambuesas, arándanos y miel.", price: "7,50 €", img: "/images/bowl-frutos-rojos.webp" },
];

const origenes = [
  {
    id: "etiopia",
    pais: "Etiopía",
    region: "Yirgacheffe",
    img: "/images/origen-etiopia.webp",
    alt: "Manos recogiendo cerezas de café maduras de la planta",
    text: "Yirgacheffe, en la zona de Gedeo, al sur de Etiopía, es una de las regiones más reconocidas del país donde nació el café. Lo cultivan pequeños productores a gran altitud, que llevan la cereza a estaciones de lavado de la zona. Es el café de nuestro espresso.",
    stats: [
      { icon: Mountain, label: "Altitud", value: "1.750 – 2.200 m" },
      { icon: Droplets, label: "Proceso", value: "Lavado" },
      { icon: Sprout, label: "Variedad", value: "Heirloom etíope" },
      { icon: Leaf, label: "Notas", value: "Jazmín, bergamota, limón" },
    ],
  },
  {
    id: "colombia",
    pais: "Colombia",
    region: "Huila",
    img: "/images/origen-colombia.webp",
    alt: "Caficultor con un cubo lleno de cerezas de café recién recogidas",
    text: "El Huila, al sur de Colombia, es hoy el departamento que más café produce del país. Sus fincas están en las laderas de los Andes y, gracias al clima, tienen dos cosechas al año. Lo usamos para los cafés con leche porque aguanta muy bien la leche.",
    stats: [
      { icon: Mountain, label: "Altitud", value: "1.500 – 2.000 m" },
      { icon: Droplets, label: "Proceso", value: "Lavado" },
      { icon: Sprout, label: "Variedad", value: "Caturra y Castillo" },
      { icon: Leaf, label: "Notas", value: "Panela, cereza, cacao" },
    ],
  },
];

const metodo = [
  { img: "/images/recoleccion.webp", title: "Recogido a mano", text: "Solo se recogen las cerezas maduras, una a una, en varias pasadas por la misma planta." },
  { img: "/images/tueste.webp", title: "Tueste en lotes de 5 kg", text: "Un tueste corto y controlado para cada origen, pensado para que se note de dónde viene." },
  { img: "/images/molienda.webp", title: "Molido al momento", text: "El molino se ajusta cada mañana según la humedad y la temperatura del día." },
  { img: "/images/barista.webp", title: "Servido con báscula", text: "Pesamos el café y el tiempo de cada extracción para que tu taza sea igual cada día." },
];

const carta = [
  {
    title: "Cafés",
    items: [
      ["Espresso", "1,90"], ["Cortado", "2,20"], ["Café con leche", "2,60"], ["Capuchino", "3,20"],
      ["Flat white", "3,40"], ["Filtro V60 del día", "3,80"], ["Cold brew", "3,80"], ["Iced latte", "4,20"],
    ],
  },
  {
    title: "Sin café",
    items: [
      ["Matcha latte", "4,50"], ["Matcha latte con lavanda", "4,90"], ["Chai latte", "4,20"],
      ["Chocolate caliente", "3,50"], ["Zumo de naranja natural", "3,90"], ["Té e infusiones", "2,80"],
    ],
  },
  {
    title: "Brunch y dulces",
    items: [
      ["Croissant de mantequilla", "2,40"], ["Banana bread", "3,20"], ["Bowl de yogur y frutos rojos", "7,50"],
      ["Tostada de guisantes y menta", "8,50"], ["Tostada de aguacate", "9,50"], ["Huevos revueltos con masa madre", "8,90"],
    ],
  },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>MÖSSA Coffee & Roots | Café de especialidad en Gràcia, Barcelona</title>
    <meta
      name="description"
      content="Cafetería de especialidad en Gràcia, Barcelona. Café de Etiopía y Colombia tostado cada semana, brunch de temporada y café para casa por suscripción."
    />
    <meta name="theme-color" content="#16100C" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/images/hero.webp" fetchpriority="high" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content="MÖSSA Coffee & Roots | Café de especialidad en Gràcia" />
    <meta property="og:description" content="Café de especialidad tostado cada semana, brunch de temporada y café para casa." />
    <meta property="og:image" content="/images/hero.webp" />
  </head>

  <body class="overflow-x-hidden antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-paper focus:px-5 focus:py-3 focus:text-ink">
      Ir al contenido
    </a>

    <!-- ============ CABECERA ============ -->
    <header id="cabecera" class="site-header fixed inset-x-0 top-0 z-50 text-white">
      <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <a href="#inicio" aria-label="MÖSSA Coffee & Roots, inicio" class="flex flex-col self-start rounded-b-2xl bg-berry px-4 pb-3 pt-4 text-center shadow-[0_10px_30px_-12px_rgba(0,0,0,0.6)] sm:px-5">
          <span class="font-display text-[22px] font-bold italic leading-none tracking-wide sm:text-[26px]">Mössa</span>
          <span class="mt-1 text-[9px] font-bold uppercase tracking-[0.28em] text-white/75">Coffee & Roots</span>
        </a>

        <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
          {nav.map((n) => (
            <a href={n.href} class="m-hover-underline text-sm font-semibold uppercase tracking-[0.12em] text-white/85 transition-colors hover:text-white">
              {n.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a href="#reservar" class="m-press hidden min-h-11 items-center rounded-full border border-white/40 px-5 text-sm font-semibold transition-colors hover:border-white hover:bg-white hover:text-ink sm:inline-flex">
            Reservar mesa
          </a>
          <button
            id="menu-toggle"
            type="button"
            aria-label="Abrir el menú"
            aria-expanded="false"
            aria-controls="menu-movil"
            class="inline-flex size-11 items-center justify-center rounded-full border border-white/30 lg:hidden"
          >
            <Menu class="size-5" id="icon-menu" />
            <X class="hidden size-5" id="icon-close" />
          </button>
        </div>
      </div>

      <div id="menu-movil" class="hidden border-t border-white/10 bg-espresso px-4 pb-6 pt-2 lg:hidden">
        <nav aria-label="Menú móvil" class="flex flex-col">
          {nav.map((n) => (
            <a href={n.href} data-close-menu class="flex min-h-12 items-center border-b border-white/10 font-display text-xl">
              {n.label}
            </a>
          ))}
          <a href="#reservar" data-close-menu class="mt-5 flex min-h-12 items-center justify-center rounded-full bg-paper text-base font-semibold text-ink">
            Reservar mesa
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <!-- ============ HERO ============ -->
      <section id="inicio" class="relative isolate flex min-h-[640px] items-center overflow-hidden bg-espresso text-white md:min-h-[88dvh]" data-parallax-scope>
        <img
          src="/images/hero.webp"
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          loading="eager"
          data-parallax="10"
          class="absolute inset-0 -z-10 h-[115%] w-full object-cover object-[70%_center]"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(22,16,12,0.94)_0%,rgba(22,16,12,0.78)_38%,rgba(22,16,12,0.2)_75%)]"></div>

        <div class="mx-auto w-full max-w-7xl px-4 pb-24 pt-32 sm:px-6 lg:px-8">
          <div class="max-w-xl lg:max-w-[740px]">
            <p class="eyebrow">Café de especialidad · Gràcia, Barcelona</p>
            <h1 class="mt-5 font-display text-[clamp(2.4rem,5.4vw,4.2rem)] leading-[1.05] tracking-[-0.01em]">
              <span class="block font-normal" data-split="words" data-split-trigger="load">Empieza el día</span>
              <span class="block font-bold" data-split="words" data-split-trigger="load">con un café de verdad</span>
            </h1>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-on-dark" data-reveal>
              Tostamos cada semana café de Etiopía y Colombia y lo servimos junto a un brunch de temporada, a un paso de la Plaça de la Virreina.
            </p>
            <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
              <a href="#carta" class="m-press inline-flex min-h-12 items-center rounded-full bg-paper px-7 text-[15px] font-bold text-ink transition-colors hover:bg-white">
                Ver la carta
              </a>
              <a href="#reservar" class="m-press inline-flex min-h-12 items-center gap-2 rounded-full border border-white/40 px-7 text-[15px] font-semibold transition-colors hover:border-white">
                Reservar mesa <ArrowRight class="size-4" />
              </a>
            </div>
            <p class="mt-10 flex items-center gap-2 text-sm text-on-dark" data-reveal>
              <Clock class="size-4 text-gold" />
              Lunes a viernes de 8:00 a 19:00 · Fines de semana de 9:00 a 15:00
            </p>
          </div>
        </div>

        <TornEdge color="#FBF8F2" seed={11} />
      </section>

      <!-- ============ CAFÉ DE ESPECIALIDAD ============ -->
      <section id="especialidad" aria-labelledby="especialidad-title" class="bg-paper py-20 md:py-28">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Lo que hay en tu taza</p>
            <h2 id="especialidad-title" class="mt-4 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold uppercase leading-[1.1] tracking-[0.02em]">
              Café de especialidad
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-ink-soft">
              No es una moda ni una forma de cobrar más. Es café que se cultiva, se tuesta y se prepara con cuidado en cada paso, y eso se nota en la taza.
            </p>
          </div>

          <div class="mt-16 grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,420px)_1fr] lg:gap-10">
            <ul class="grid gap-10 lg:text-right" data-stagger>
              {especialidadIzq.map((f) => (
                <li class="flex gap-4 lg:flex-row-reverse">
                  <span class="flex size-12 flex-none items-center justify-center rounded-full border border-cream-2 text-gold">
                    <f.icon class="size-5" />
                  </span>
                  <span>
                    <span class="block font-display text-xl font-bold">{f.title}</span>
                    <span class="mt-1.5 block text-[15px] leading-relaxed text-ink-soft">{f.text}</span>
                  </span>
                </li>
              ))}
            </ul>

            <div class="relative mx-auto aspect-square w-full max-w-[340px] lg:max-w-none" data-reveal>
              <div class="absolute inset-[-6%] rounded-full border border-dashed border-cream-2"></div>
              <img
                src="/images/taza-cenital.webp"
                alt="Taza de café solo vista desde arriba sobre fondo oscuro"
                width="900"
                height="900"
                loading="lazy"
                decoding="async"
                class="relative size-full rounded-full object-cover shadow-[0_40px_80px_-30px_rgba(35,25,18,0.55)]"
              />
            </div>

            <ul class="grid gap-10" data-stagger>
              {especialidadDer.map((f) => (
                <li class="flex gap-4">
                  <span class="flex size-12 flex-none items-center justify-center rounded-full border border-cream-2 text-gold">
                    <f.icon class="size-5" />
                  </span>
                  <span>
                    <span class="block font-display text-xl font-bold">{f.title}</span>
                    <span class="mt-1.5 block text-[15px] leading-relaxed text-ink-soft">{f.text}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ============ TRES IMÁGENES ============ -->
      <section aria-label="Lo que hacemos" class="grid grid-cols-1 sm:grid-cols-3" data-stagger>
        {tiles.map((t) => (
          <a href={t.href} class="m-hover-zoom group relative block h-64 overflow-hidden sm:h-80 lg:h-[380px]">
            <img src={t.img} alt={t.alt} width="900" height="700" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-espresso/10 to-transparent"></span>
            <span class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 p-6 text-white">
              <span class="font-display text-2xl font-bold">{t.label}</span>
              <ArrowRight class="size-5 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </section>

      <!-- ============ LO MÁS PEDIDO ============ -->
      <section id="destacados" aria-labelledby="destacados-title" class="paper-grain relative bg-cream py-20 md:py-28">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
            <div>
              <p class="eyebrow">Lo más pedido</p>
              <h2 id="destacados-title" class="mt-3 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.1]">Lo que más se pide en barra</h2>
            </div>
            <div class="flex items-center gap-2">
              <div role="tablist" aria-label="Tipo de producto" class="mr-2 flex rounded-full bg-paper p-1">
                <button type="button" role="tab" aria-selected="true" data-tab="cafe" class="tab min-h-10 rounded-full px-5 text-sm font-bold">Cafés</button>
                <button type="button" role="tab" aria-selected="false" data-tab="brunch" class="tab min-h-10 rounded-full px-5 text-sm font-bold">Brunch</button>
              </div>
              <button type="button" data-rail="prev" aria-label="Anterior" class="hidden size-11 items-center justify-center rounded-full border border-ink/15 transition-colors hover:bg-paper md:inline-flex">
                <ArrowLeft class="size-4" />
              </button>
              <button type="button" data-rail="next" aria-label="Siguiente" class="hidden size-11 items-center justify-center rounded-full border border-ink/15 transition-colors hover:bg-paper md:inline-flex">
                <ArrowRight class="size-4" />
              </button>
            </div>
          </div>

          <div id="rail" class="rail -mx-4 mt-10 flex gap-5 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0" data-stagger>
            {productos.map((p) => (
              <article data-cat={p.cat} class:list={["product w-[78%] flex-none rounded-3xl bg-paper p-3 shadow-[0_18px_40px_-28px_rgba(35,25,18,0.45)] sm:w-[46%] lg:w-[calc((100%-3.75rem)/4)]", p.cat !== "cafe" && "hidden"]}>
                <div class="relative aspect-square overflow-hidden rounded-2xl">
                  <img src={p.img} alt={p.name} width="800" height="800" loading="lazy" decoding="async" class="size-full object-cover" />
                  {p.tag && (
                    <span class="absolute left-3 top-3 rounded-full bg-paper/95 px-3 py-1 text-xs font-bold text-berry">{p.tag}</span>
                  )}
                </div>
                <div class="flex flex-col gap-2 px-2 pb-3 pt-4">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-display text-xl font-bold leading-tight">{p.name}</h3>
                    <span class="flex-none text-lg font-bold text-berry">{p.price}</span>
                  </div>
                  <p class="text-[15px] leading-relaxed text-ink-soft">{p.desc}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ ORÍGENES ============ -->
      <section id="origenes" aria-labelledby="origenes-title" class="bg-paper">
        <h2 id="origenes-title" class="sr-only">Nuestros orígenes</h2>
        {origenes.map((o, i) => (
          <div class="grid lg:grid-cols-2">
            <div class:list={["relative h-80 overflow-hidden sm:h-[420px] lg:h-auto lg:min-h-[560px]", i % 2 === 1 && "lg:order-2"]}>
              {i === 0 ? (
                <div class="absolute inset-0"><div data-split-reveal="rows" data-src={o.img} data-alt={o.alt} class="size-full"></div></div>
              ) : (
                <img src={o.img} alt={o.alt} width="1200" height="1000" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
              )}
            </div>
            <div class="flex items-center px-4 py-16 sm:px-10 lg:px-16 lg:py-20">
              <div class="max-w-xl" data-reveal>
                <p class="eyebrow">{i === 0 ? "Nuestros orígenes" : "Segundo origen"}</p>
                <h3 class="mt-3 font-display text-[clamp(2rem,3.4vw,2.8rem)] font-bold leading-[1.1]">
                  {o.pais} <span class="font-normal italic text-ink-soft">· {o.region}</span>
                </h3>
                <p class="mt-5 text-[17px] leading-relaxed text-ink-soft">{o.text}</p>
                <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4">
                  {o.stats.map((s) => (
                    <div class="flex flex-col gap-2">
                      <s.icon class="size-6 text-gold" />
                      <dt class="text-xs font-bold uppercase tracking-[0.14em]">{s.label}</dt>
                      <dd class="text-[15px] leading-snug text-ink-soft">{s.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </div>
        ))}
      </section>

      <!-- ============ CÓMO TRABAJAMOS ============ -->
      <section aria-labelledby="metodo-title" class="paper-grain relative bg-cream py-20 md:py-28">
        <TornEdge color="#FBF8F2" position="top" seed={23} />
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Del cafetal a la taza</p>
            <h2 id="metodo-title" class="mt-4 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold uppercase leading-[1.1] tracking-[0.02em]">
              Cómo trabajamos
            </h2>
          </div>
          <ol class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
            {metodo.map((m, i) => (
              <li class="flex flex-col items-center text-center">
                <span class="relative">
                  <img src={m.img} alt="" width="500" height="500" loading="lazy" decoding="async" class="size-44 rounded-full object-cover ring-8 ring-paper sm:size-48" />
                  <span class="absolute -right-1 top-2 flex size-10 items-center justify-center rounded-full bg-berry font-display text-base font-bold text-white">{i + 1}</span>
                </span>
                <h3 class="mt-6 font-display text-xl font-bold">{m.title}</h3>
                <p class="mt-2 max-w-[260px] text-[15px] leading-relaxed text-ink-soft">{m.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <TornEdge color="#FBF8F2" seed={31} />
      </section>

      <!-- ============ CAFÉ PARA CASA ============ -->
      <section id="cafe-en-casa" aria-labelledby="casa-title" class="bg-paper py-20 md:py-28">
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:gap-20 lg:px-8">
          <div class="relative" data-reveal>
            <div class="absolute -left-4 -top-4 h-full w-full rounded-[2rem] border border-cream-2"></div>
            <img
              src="/images/bolsa-cafe.webp"
              alt="Bolsa de papel kraft de café en grano cerrada"
              width="900"
              height="1100"
              loading="lazy"
              decoding="async"
              class="relative aspect-[4/5] w-full rounded-[2rem] object-cover"
            />
          </div>
          <div data-reveal>
            <p class="eyebrow">Café para casa</p>
            <h2 id="casa-title" class="mt-3 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.1]">
              El mismo café, recién tostado, en tu casa
            </h2>
            <p class="mt-5 text-[17px] leading-relaxed text-ink-soft">
              Cada semana tostamos un poco más para quien quiere tomarlo en casa. Puedes llevarte una bolsa en la tienda o recibirlo cada mes.
            </p>
            <div class="mt-8 flex flex-wrap items-end gap-x-8 gap-y-3">
              <p><span class="font-display text-4xl font-bold text-berry">29 €</span> <span class="text-ink-soft">/ mes</span></p>
              <p class="pb-1 text-[15px] text-ink-soft">o una bolsa de 250 g por <strong class="text-ink">14,50 €</strong></p>
            </div>
            <ul class="mt-7 grid gap-3">
              {[
                "Dos bolsas de 250 g del origen del mes",
                "En grano o molido para tu cafetera: italiana, filtro o espresso",
                "Envío gratis a la península en 48 – 72 h",
                "Sin permanencia: la pausas o la cancelas cuando quieras",
              ].map((li) => (
                <li class="flex items-start gap-3 text-[16px]">
                  <span class="mt-0.5 flex size-6 flex-none items-center justify-center rounded-full bg-berry/10 text-berry"><Check class="size-3.5" /></span>
                  {li}
                </li>
              ))}
            </ul>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#visitanos" class="m-press inline-flex min-h-12 items-center rounded-full bg-berry px-7 text-[15px] font-bold text-white transition-colors hover:bg-berry-2">
                Quiero la suscripción
              </a>
              <a href="#carta" class="m-press inline-flex min-h-12 items-center rounded-full border border-ink/20 px-7 text-[15px] font-semibold transition-colors hover:border-ink">
                Ver precios en tienda
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ CÓMO PREPARAMOS TU ESPRESSO ============ -->
      <section id="proceso" aria-labelledby="proceso-title" class="relative isolate overflow-hidden bg-espresso py-28 text-white md:py-36" data-parallax-scope>
        <TornEdge color="#FBF8F2" position="top" seed={41} />
        <img src="/images/proceso.webp" alt="" width="1920" height="1100" loading="lazy" decoding="async" data-parallax="12" class="absolute inset-0 -z-10 h-[120%] w-full object-cover opacity-45" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-espresso/70 via-espresso/60 to-espresso/85"></div>
        <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
          <p class="eyebrow" data-reveal>Nuestra receta</p>
          <h2 id="proceso-title" class="mt-4 font-display text-[clamp(2rem,4vw,3.4rem)] font-bold uppercase leading-[1.1] tracking-[0.02em]" data-reveal>
            ¿Cómo preparamos tu espresso?
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-on-dark" data-reveal>
            Una receta clásica, medida en cada taza: el doble de bebida que de café molido. Si un día sale distinto, lo repetimos.
          </p>
          <dl class="mt-14 grid gap-6 sm:grid-cols-3" data-stagger>
            {[
              { icon: Scale, n: "18", unit: "g", label: "de café recién molido" },
              { icon: Timer, n: "28", unit: "s", label: "de extracción, entre 25 y 32" },
              { icon: Coffee, n: "36", unit: "g", label: "de espresso en la taza" },
            ].map((s) => (
              <div class="rounded-3xl border border-white/10 bg-white/[0.04] px-6 py-8 backdrop-blur-[2px]">
                <s.icon class="mx-auto size-6 text-gold" />
                <dd class="mt-4 font-display text-6xl font-bold leading-none">
                  <span data-counter={s.n}>{s.n}</span><span class="ml-1 text-3xl font-normal text-on-dark">{s.unit}</span>
                </dd>
                <dt class="mt-3 text-[15px] text-on-dark">{s.label}</dt>
              </div>
            ))}
          </dl>
        </div>
        <TornEdge color="#FBF8F2" seed={53} />
      </section>

      <!-- ============ CARTA ============ -->
      <section id="carta" aria-labelledby="carta-title" class="bg-paper py-20 md:py-28">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Carta</p>
            <h2 id="carta-title" class="mt-4 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.1]">Para tomar aquí o para llevar</h2>
            <p class="mt-4 text-[17px] text-ink-soft">Bebida de avena o de almendra sin coste extra. Tenemos descafeinado.</p>
          </div>
          <div class="mt-14 grid gap-12 md:grid-cols-3" data-stagger>
            {carta.map((c) => (
              <div>
                <h3 class="border-b-2 border-ink pb-3 font-display text-2xl font-bold">{c.title}</h3>
                <ul class="mt-2">
                  {c.items.map(([name, price]) => (
                    <li class="flex items-baseline gap-3 border-b border-cream-2 py-3.5 text-[16px]">
                      <span>{name}</span>
                      <span aria-hidden="true" class="flex-1 translate-y-[-3px] border-b border-dotted border-ink/25"></span>
                      <span class="whitespace-nowrap font-semibold text-berry">{price} €</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ VISÍTANOS ============ -->
      <section id="visitanos" aria-labelledby="visitanos-title" class="paper-grain relative bg-cream py-20 md:py-28">
        <TornEdge color="#FBF8F2" position="top" seed={61} />
        <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:px-8">
          <div class="flex flex-col gap-8" data-reveal>
            <div>
              <p class="eyebrow">Visítanos</p>
              <h2 id="visitanos-title" class="mt-3 font-display text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.1]">
                En el corazón de Gràcia
              </h2>
            </div>
            <img
              src="/images/local.webp"
              alt="Barra de una cafetería con la máquina de espresso y luces cálidas"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full rounded-[2rem] object-cover"
            />
            <div class="grid gap-6 sm:grid-cols-2">
              <div class="flex gap-3">
                <MapPin class="mt-1 size-5 flex-none text-gold" />
                <div>
                  <p class="font-bold">Carrer de Torrijos, 48</p>
                  <p class="text-[15px] text-ink-soft">Gràcia, Barcelona. Junto a la Plaça de la Virreina.</p>
                  <a
                    href="https://www.google.com/maps/search/?api=1&query=Carrer+de+Torrijos+Gr%C3%A0cia+Barcelona"
                    target="_blank"
                    rel="noopener"
                    class="mt-2 inline-flex min-h-11 items-center gap-1.5 text-[15px] font-bold text-berry underline underline-offset-4"
                  >
                    <Navigation class="size-4" /> Cómo llegar
                  </a>
                </div>
              </div>
              <div class="flex gap-3">
                <TrainFront class="mt-1 size-5 flex-none text-gold" />
                <div>
                  <p class="font-bold">Metro</p>
                  <p class="text-[15px] text-ink-soft">Joanic (L4) y Fontana (L3), a unos 8 minutos a pie.</p>
                </div>
              </div>
              <div class="flex gap-3 sm:col-span-2">
                <Clock class="mt-1 size-5 flex-none text-gold" />
                <dl class="grid flex-1 gap-1.5">
                  {horario.map((h) => (
                    <div class="flex flex-wrap justify-between gap-x-4 border-b border-cream-2 pb-1.5 text-[15px]">
                      <dt class="text-ink-soft">{h.dias}</dt>
                      <dd class="font-semibold">{h.horas}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </div>

          <!-- Reserva -->
          <div id="reservar" class="self-start rounded-[2rem] bg-paper p-6 shadow-[0_30px_60px_-40px_rgba(35,25,18,0.5)] sm:p-9" data-reveal>
            <h3 class="font-display text-3xl font-bold">Reserva tu mesa</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">
              Reservamos mesas para el brunch de fin de semana y para grupos de 5 o más. Entre semana no hace falta: ven cuando quieras.
            </p>
            <form id="form-reserva" class="mt-7 grid gap-4" novalidate>
              <label class="grid gap-1.5 text-sm font-semibold">
                Nombre
                <input name="nombre" required autocomplete="name" class="min-h-12 rounded-xl border border-cream-2 bg-white px-4 text-base font-normal focus:border-berry focus:outline-none" />
              </label>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="grid gap-1.5 text-sm font-semibold">
                  Día
                  <input type="date" name="dia" required class="min-h-12 rounded-xl border border-cream-2 bg-white px-4 text-base font-normal focus:border-berry focus:outline-none" />
                </label>
                <label class="grid gap-1.5 text-sm font-semibold">
                  Hora
                  <select name="hora" class="min-h-12 rounded-xl border border-cream-2 bg-white px-4 text-base font-normal focus:border-berry focus:outline-none">
                    <option>9:00</option><option>10:00</option><option selected>11:00</option><option>12:00</option><option>13:00</option>
                  </select>
                </label>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="grid gap-1.5 text-sm font-semibold">
                  Personas
                  <select name="personas" class="min-h-12 rounded-xl border border-cream-2 bg-white px-4 text-base font-normal focus:border-berry focus:outline-none">
                    <option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option>
                  </select>
                </label>
                <label class="grid gap-1.5 text-sm font-semibold">
                  Teléfono
                  <input type="tel" name="telefono" required autocomplete="tel" inputmode="tel" class="min-h-12 rounded-xl border border-cream-2 bg-white px-4 text-base font-normal focus:border-berry focus:outline-none" />
                </label>
              </div>
              <button type="submit" class="m-press mt-2 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-berry px-7 text-[15px] font-bold text-white transition-colors hover:bg-berry-2">
                <CalendarCheck class="size-4" />Pedir reserva
              </button>
              <p id="reserva-ok" role="status" class="hidden rounded-xl bg-cream px-4 py-3 text-[15px]"></p>
              <p id="reserva-error" role="alert" class="hidden text-[15px] font-semibold text-berry">Rellena tu nombre, el día y un teléfono para poder confirmarte la reserva.</p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ PIE ============ -->
    <footer class="relative bg-espresso pt-20 text-white">
      <TornEdge color="#F3ECE0" position="top" seed={71} />
      <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
        <div>
          <p class="font-display text-3xl font-bold italic">Mössa</p>
          <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.28em] text-on-dark">Coffee & Roots</p>
          <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-on-dark">
            Café de especialidad, brunch de temporada y café para casa en Gràcia, Barcelona.
          </p>
          <a href="#" aria-label="Instagram de Mössa" class="mt-6 inline-flex size-11 items-center justify-center rounded-full border border-white/20 transition-colors hover:border-white">
            <Instagram class="size-5" />
          </a>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em]">Horario</p>
          <dl class="mt-4 grid gap-3 text-[15px] text-on-dark">
            {horario.map((h) => (
              <div><dt>{h.dias}</dt><dd class="font-semibold text-white">{h.horas}</dd></div>
            ))}
          </dl>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em]">Dónde</p>
          <p class="mt-4 text-[15px] leading-relaxed text-on-dark">Carrer de Torrijos, 48<br />Gràcia, Barcelona</p>
          <nav aria-label="Pie" class="mt-5 flex flex-col">
            {nav.map((n) => (
              <a href={n.href} class="flex min-h-10 items-center text-[15px] text-on-dark transition-colors hover:text-white">{n.label}</a>
            ))}
          </nav>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-on-dark sm:flex-row sm:justify-between sm:px-6 lg:px-8">
          <p>© 2026 Mössa Coffee & Roots</p>
          <p>Diseño web: <a href="https://webestatica.com" class="font-semibold text-white underline underline-offset-4">Webestatica</a></p>
        </div>
      </div>
    </footer>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";
      import { initMotion } from "../scripts/motion.js";

      initMotion({ gsap, ScrollTrigger, Lenis }, { level: "media" });

      /* Cabecera: sólida al salir del hero */
      const header = document.getElementById("cabecera");
      const onScroll = () => header?.classList.toggle("is-solid", window.scrollY > 40);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      /* Menú móvil */
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu-movil");
      const setMenu = (open: boolean) => {
        menu?.classList.toggle("hidden", !open);
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.setAttribute("aria-label", open ? "Cerrar el menú" : "Abrir el menú");
        document.getElementById("icon-menu")?.classList.toggle("hidden", open);
        document.getElementById("icon-close")?.classList.toggle("hidden", !open);
        if (open) header?.classList.add("is-solid");
        else onScroll();
      };
      toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
      document.querySelectorAll("[data-close-menu]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));

      /* Lo más pedido: pestañas y flechas */
      const rail = document.getElementById("rail");
      const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
      const paintTabs = () =>
        tabs.forEach((t) => {
          const on = t.getAttribute("aria-selected") === "true";
          t.classList.toggle("bg-ink", on);
          t.classList.toggle("text-paper", on);
          t.classList.toggle("text-ink-soft", !on);
        });
      tabs.forEach((tab) =>
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
          paintTabs();
          document.querySelectorAll<HTMLElement>(".product").forEach((p) => {
            p.classList.toggle("hidden", p.dataset.cat !== tab.dataset.tab);
            p.style.opacity = "1";
            p.style.transform = "none";
          });
          rail?.scrollTo({ left: 0, behavior: "smooth" });
        }),
      );
      paintTabs();
      document.querySelectorAll<HTMLButtonElement>("[data-rail]").forEach((b) =>
        b.addEventListener("click", () => {
          const card = rail?.querySelector<HTMLElement>(".product:not(.hidden)");
          const step = card ? card.offsetWidth + 20 : 300;
          rail?.scrollBy({ left: b.dataset.rail === "next" ? step : -step, behavior: "smooth" });
        }),
      );

      /* Reserva: validación y mensaje de confirmación (de momento no envía datos a ningún servidor) */
      const form = document.getElementById("form-reserva") as HTMLFormElement | null;
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const ok = document.getElementById("reserva-ok");
        const err = document.getElementById("reserva-error");
        if (!form.checkValidity()) {
          err?.classList.remove("hidden");
          ok?.classList.add("hidden");
          return;
        }
        const d = new FormData(form);
        err?.classList.add("hidden");
        if (ok) {
          ok.textContent = `Gracias, ${d.get("nombre")}. Hemos recibido tu solicitud de mesa para ${d.get("personas")} el ${d.get("dia")} a las ${d.get("hora")}. Te llamaremos para confirmarla.`;
          ok.classList.remove("hidden");
        }
        form.reset();
      });
    </script>
  </body>
</html>
