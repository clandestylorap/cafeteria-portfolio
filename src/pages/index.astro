---
import '../styles/global.css'

const menuPrimavera = [
  {
    title: "Iced Matcha amb Lavanda",
    description: "Matcha japonès batut a mà amb llet fresca i un toc de xarop casolà de lavanda. Refrescant, floral i profundament serè.",
    price: "5,90€",
    image: "🥤",
    tags: ["edició limitada", "fred"],
	image_url: "images/menu_1.png",
  },
  {
    title: "Torrada de Pèsols i Menta",
    description: "Llesca de pagès torrada amb crema de pèsols tendres, menta fresca i oli d'oliva verge extra. Lluminosament verda i cruixent.",
    price: "8,20€",
    image: "🥑",
    tags: ["vegà", "sense gluten"],
	image_url: "images/menu_2.png",
  },
  {
    title: "Bowl de Fruits del Bosc",
    description: "Barreja de gerds, nabius i mores amb iogurt cremós, granola torrada a la casa i mel de proximitat.",
    price: "7,90€",
    image: "🍓",
    tags: ["sense gluten", "vegetarià"],
	image_url: "images/menu_3.png",
  }
];

const especialitat = [
  { name: "Espresso", price: "2,20€", desc: "Curt, intens i brillant. Extracció precisa per revelar cada matís del gra.", origin: "Etiòpia", notes: "cítric, florals", image_url: "images/expresso.jpg"},
  { name: "Flat White", price: "3,50€", desc: "Doble espresso amb llet emulsionada sedosa. Equilibri perfecte entre cos i cremositat.", origin: "Colòmbia", notes: "xocolata, nous", image_url: "images/flat_white.jpg" },
  { name: "Cold Brew", price: "4,00€", desc: "Infusionat en fred durant 16 hores. Dolç naturalment, sense pressa ni amargors.", origin: "Nicaragua", notes: "caramel, fruita", image_url: "images/cold.jpg" },
  { name: "Torrada d'Alvocat", price: "8,50€", desc: "Pa de massa mare, alvocat madur, llavors torrades i llima fresca. El nostre clàssic de brunch.", tags: ["vegà", "sense gluten"] },
];

const reviews = [
  { quote: "Cada matí, el primer glop de cafè a MÖSSA em recorda que la ciutat també pot respirar amb calma.", name: "Laia, veïna de Gràcia", rating: 5 },
  { quote: "És el lloc on el soroll queda fora i només entren els bons llibres i l’aroma de cafè acabat de moldre.", name: "Jordi, treballador remot", rating: 5 },
  { quote: "Han convertit la pausa del cafè en un petit ritual diari. El personal et coneix pel nom i pel tipus de gra.", name: "Mar, habitual de caps de setmana", rating: 5 },
];
---

<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MÖSSA · Coffee & Roots | Cafè d'especialitat a Gràcia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;700&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#fcf9f0] text-[#2e241e] font-sans antialiased overflow-x-hidden">
    
    <header class="sticky top-0 z-50 bg-[#fcf9f0]/80 backdrop-blur-md border-b border-black/5 px-4 py-3 md:px-10">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 md:gap-3 group">
          <div class="w-10 h-10 md:w-12 md:h-12 bg-[#b6c9a0] rounded-xl flex items-center justify-center text-xl md:text-3xl font-bold shadow-md">M</div>
          <span class="font-serif text-xl md:text-3xl tracking-tight uppercase">MÖSSA<span class="text-[#5f4e44] font-light">·</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-lg font-semibold">
          <a href="#cafe" class="hover:text-[#cb9b7c] transition-colors">Cafè</a>
          <a href="#menu" class="hover:text-[#cb9b7c] transition-colors">Promocions</a>
          <a href="#contacte" class="hover:text-[#cb9b7c] transition-colors">Visita'ns</a>
        </nav>

        <a href="#contacte" class="bg-[#2e241e] text-[#fcf9f0] px-4 py-2 md:px-8 md:py-4 rounded-full text-xs md:text-lg font-bold uppercase tracking-wide hover:bg-[#3f312a] transition-all">Reserva</a>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 md:px-8">
      
      <section class="py-12 md:py-24 grid lg:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <div class="inline-block bg-[#b6c9a0] text-white px-4 py-2 md:px-6 md:py-3 rounded-full text-xs md:text-sm font-bold uppercase tracking-wide mb-6 md:mb-8">🔥 Obertura diària · Gràcia</div>
          <h1 class="font-serif text-7xl md:text-8xl lg:text-8xl leading-[1.1] tracking-tight">
            El ritual de la calma <span class="text-[#cb9b7c] lg:block">en cada tassa</span>
          </h1>
          <p class="text-lg md:text-2xl text-[#3f332c] max-w-xl mt-6 md:mt-8 leading-relaxed">
            Cafè d'especialitat de temporada, brunch artesà i un refugi on el temps s'alenteix.
          </p>

		  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12 md:mt-16">
			<div class="bg-white rounded-[2rem] p-6 shadow-xl flex items-center gap-4 min-w-0 overflow-hidden border border-black/5">
			  <div class="text-4xl md:text-6xl font-black leading-none flex-shrink-0">4.9</div>
			  
			  <div class="min-w-0">
				<div class="flex text-[#cb9b7c] text-sm md:text-lg mb-1">★★★★★</div>
				<p class="text-xs text-gray-500 font-semibold leading-tight whitespace-normal break-words">
				  200+ ressenyes
				</p>
			  </div>
			</div>
		  
			<div class="bg-white rounded-[2rem] p-6 shadow-xl flex items-center gap-4 min-w-0 overflow-hidden border border-black/5">
			  <div class="flex -space-x-3 flex-shrink-0">
				<div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#b6c9a0] border-2 border-white flex items-center justify-center font-bold text-[10px] shadow-sm">ML</div>
				<div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#edd6b0] border-2 border-white flex items-center justify-center font-bold text-[10px] text-[#2e241e] shadow-sm">JC</div>
			  </div>
			  <div class="min-w-0">
				<span class="text-2xl md:text-3xl font-bold block leading-none">150+</span>
				<span class="text-gray-600 text-xs leading-tight block whitespace-normal mt-1">
				  clients habituals
				</span>
			  </div>
			</div>
		  </div>

          <div class="flex flex-col sm:flex-row gap-4 mt-8 md:mt-12">
            <a href="#contacte" class="bg-[#2e241e] text-[#fcf9f0] px-8 py-4 md:px-12 md:py-6 rounded-full text-lg md:text-2xl font-bold shadow-xl hover:scale-105 transition-all text-center">📍 Troba'ns</a>
            <a href="#menu" class="border-4 border-[#2e241e] text-[#2e241e] px-8 py-4 md:px-12 md:py-6 rounded-full text-lg md:text-2xl font-bold hover:bg-black/5 transition-all text-center">🥐 Promocions</a>
          </div>
        </div>

        <div class="bg-white rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-10 shadow-2xl border border-black/5">
          <span class="bg-[#b6c9a0] text-[10px] md:text-xs uppercase tracking-widest px-4 py-2 rounded-full inline-block mb-6">🌱 GRA DEL MES · ETIÒPIA</span>
          <h2 class="font-serif text-4xl md:text-5xl mb-4">Yirgacheffe</h2>
          <div class="flex flex-wrap gap-2 md:gap-4 mb-6 md:mb-8">
            <span class="bg-[#b6c9a0]/30 px-4 py-2 rounded-full text-sm md:text-lg">nabiu</span>
            <span class="bg-[#b6c9a0]/30 px-4 py-2 rounded-full text-sm md:text-lg">gesmí</span>
            <span class="bg-[#b6c9a0]/30 px-4 py-2 rounded-full text-sm md:text-lg">mel</span>
          </div>
          <p class="text-lg md:text-xl text-gray-700 mb-8">Collita rentada, torrat suau. Ideal en V60 o Chemex.</p>
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-t border-gray-200 pt-8 gap-4">
            <span class="text-4xl md:text-5xl font-black">15,50€</span>
            <span class="bg-[#2e241e] text-white px-6 py-3 md:px-8 md:py-4 rounded-full text-sm md:text-lg font-semibold text-center uppercase tracking-wider">250g · ed. limitada</span>
          </div>
          <div class="mt-8">
            <div class="bg-gray-200 h-3 md:h-5 rounded-full overflow-hidden">
                <div class="bg-[#cb9b7c] h-full" style="width: 65%"></div>
            </div>
            <p class="text-right mt-2 text-xs md:text-sm text-gray-600">65% del lot venut aquesta setmana</p>
          </div>
        </div>
      </section>

	  <section id="menu" class="py-16">
        <div class="mb-12 md:mb-16">
            <h2 class="font-serif text-5xl md:text-7xl mb-4">🌸 Promocions de primavera</h2>
            <div class="w-24 h-1 bg-[#cb9b7c] rounded-full"></div>
            <p class="text-xl md:text-2xl text-[#3f332c] mt-8 max-w-2xl">Sabors que desperten la llum. Edició limitada fins al 21 de juny.</p>
        </div>

        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {menuPrimavera.map(item => (
            <article class="group bg-white rounded-[2rem] md:rounded-[2.5rem] overflow-hidden shadow-xl hover:shadow-2xl transition-all border border-black/5 flex flex-col">
              
              <div class="relative aspect-[4/3] overflow-hidden bg-[#eae2d7] flex items-center justify-center">
                
                {/* 1. Muestra la imagen si existe la propiedad image_url */}
                {item.image_url ? (
                  <img 
                    src={item.image_url} 
                    alt={item.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out"
                    loading="lazy"
                  />
                ) : (
                  /* 2. Si no hay imagen, muestra el emoji como fallback */
                  <div class="text-6xl group-hover:scale-110 transition-transform duration-500">
                    {item.image} 
                  </div>
                )}

                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>

              <div class="p-6 md:p-8 flex flex-col flex-grow">
                <div class="flex flex-wrap gap-2 mb-4">
                  {item.tags.map(tag => (
                    <span class="inline-block bg-[#edd6b0]/50 px-3 py-1 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-wider text-[#5f4e44]">
                      {tag}
                    </span>
                  ))}
                </div>

                <h3 class="font-serif text-2xl md:text-3xl mb-3 leading-tight group-hover:text-[#cb9b7c] transition-colors">
                  {item.title}
                </h3>
                
                <p class="text-gray-600 text-sm md:text-base mb-6 leading-relaxed">
                  {item.description}
                </p>
                
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-black/5">
                  <span class="text-2xl md:text-3xl font-black">{item.price}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="cafe" class="py-16">
        <h2 class="font-serif text-5xl md:text-7xl mb-12 md:mb-16">☕ Especialitats</h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
			<div class="lg:col-span-2 bg-[#eae2d7] rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-12">
				<span class="bg-[#2e241e] text-white px-6 py-2 rounded-full text-xs uppercase tracking-widest">cafès d'autor</span>
				
				<div class="grid grid-cols-1 gap-6 mt-10">
				  {especialitat.slice(0,3).map(coffee => (
					<div class="group bg-white/80 rounded-2xl md:rounded-3xl p-5 md:p-6 backdrop-blur-sm shadow-sm flex flex-col md:flex-row gap-6 hover:bg-white transition-all duration-300 border border-black/5">
					  
					  <div class="w-full md:w-48 h-56 md:h-48 flex-shrink-0 rounded-2xl overflow-hidden bg-[#d6cdc0] flex items-center justify-center">
						{coffee.image_url ? (
						  <img 
							src={coffee.image_url} 
							alt={coffee.name}
							/* object-cover centra la imagen y la recorta para llenar el espacio sin deformarse */
							class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700"
						  />
						) : (
						  <div class="text-5xl bg-black/5 w-full h-full flex items-center justify-center">☕</div>
						)}
					  </div>
	
					  <div class="flex flex-col justify-between flex-grow min-w-0">
						<div>
						  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-x-4 mb-3">
							<h3 class="font-serif text-2xl md:text-3xl leading-tight">{coffee.name}</h3>
							<span class="text-xl md:text-2xl font-black text-[#cb9b7c] shrink-0">{coffee.price}</span>
						  </div>
						  
						  <p class="text-gray-700 text-sm md:text-base mb-6 leading-relaxed">
							{coffee.desc}
						  </p>
						</div>
	
						<div class="flex flex-wrap gap-2 mt-auto">
						  <span class="inline-block bg-[#b6c9a0] px-3 py-1 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-wider">
							{coffee.origin}
						  </span>
						  <span class="inline-block bg-[#edd6b0] px-3 py-1 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-wider">
							{coffee.notes}
						  </span>
						</div>
					  </div>
					</div>
				  ))}
				</div>
			  </div>

		<!-- CARD HORARI - VERSIÓ AMPLADA I PREMIUM -->
		<div class="bg-gradient-to-br from-[#edd6b0] to-[#e5c9a0] rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-10 shadow-2xl hover:shadow-3xl transition-all duration-300 relative overflow-hidden group w-full">
		
			<!-- Elements decoratius de fons (més grans) -->
			<div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -mr-20 -mt-20"></div>
			<div class="absolute bottom-0 left-0 w-80 h-80 bg-white/10 rounded-full blur-3xl -mb-20 -ml-20"></div>
			
			<!-- Contingut principal amb més amplada -->
			<div class="relative z-10 space-y-8">
			
			<!-- Capçalera amb icona i estat actual -->
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<div class="flex items-center gap-4">
				<div>
					<span class="text-sm font-black uppercase tracking-[0.2em] text-[#2e241e]/70">HORARI</span>
					<h3 class="font-serif text-3xl md:text-3xl text-[#2e241e]">Quan trobar-nos</h3>
				</div>
				</div>
			</div>
		
			<!-- Horari principal amb disseny de doble columna -->
			<div class="grid grid-cols-1 md:grid-cols-1 gap-6 bg-white/20 backdrop-blur-sm rounded-3xl p-6 md:p-8">
				
				<!-- Dies laborables -->
				<div class="flex flex-col space-y-3">
				<div class="flex items-center gap-3">
					<span class="text-2xl md:text-3xl font-black text-[#2e241e]">DL - DV</span>
				</div>
				<div class="flex items-baseline justify-between pl-2">
					<span class="text-gray-600 text-lg">Matí</span>
					<span class="text-3xl md:text-4xl font-black text-[#2e241e]">8:30</span>
					<span class="text-xl text-[#2e241e]">- 14h</span>
				</div>
				<div class="flex items-baseline justify-between pl-2 border-t border-[#2e241e]/10 pt-3">
					<span class="text-gray-600 text-lg">Tarda</span>
					<span class="text-3xl md:text-4xl font-black text-[#2e241e]">16:00</span>
					<span class="text-xl text-[#2e241e]">- 20h</span>
				</div>
				<span class="text-xs text-[#2e241e]/60 mt-2 block">⏰ Tancat de 14h a 16h</span>
				</div>
				
				<!-- Cap de setmana -->
				<div class="flex flex-col space-y-3">
				<div class="flex items-center gap-3">
					<span class="text-2xl md:text-3xl font-black text-[#2e241e]">DS - DG</span>
				</div>
				<div class="flex items-baseline justify-between pl-2">
					<span class="text-gray-600 text-lg">Matí</span>
					<span class="text-3xl md:text-4xl font-black text-[#2e241e]">9:30</span>
					<span class="text-xl text-[#2e241e]">- 15h</span>
				</div>
				<div class="flex items-baseline justify-between pl-2 border-t border-[#2e241e]/10 pt-3">
					<span class="text-gray-600 text-lg">Tarda</span>
					<span class="text-3xl md:text-4xl font-black text-[#2e241e]">17:00</span>
					<span class="text-xl text-[#2e241e]">- 21h</span>
				</div>
				<span class="text-xs text-[#2e241e]/60 mt-2 block">⏰ Horari intensiu caps de setmana</span>
				</div>
			</div>
		
			<!-- Serveis destacats amb disseny més ampli -->
			<div class="grid grid-cols-1 sm:grid-cols-1 gap-4 pt-4">
				<div class="bg-white/40 backdrop-blur-sm rounded-2xl p-5 flex items-center gap-4">
				<div class="w-14 h-14 bg-[#b6c9a0] rounded-xl flex items-center justify-center text-3xl shadow-lg">🥐</div>
				<div>
					<span class="text-lg font-black text-[#2e241e] block">Brunch</span>
					<span class="text-sm text-[#2e241e]/70">tot el dia · DV a DG</span>
				</div>
				</div>
				
				<div class="bg-white/40 backdrop-blur-sm rounded-2xl p-5 flex items-center gap-4">
				<div class="w-14 h-14 bg-[#cb9b7c] rounded-xl flex items-center justify-center text-3xl shadow-lg">📶</div>
				<div>
					<span class="text-lg font-black text-[#2e241e] block">WiFi</span>
					<span class="text-sm text-[#2e241e]/70">bona connexió a tot el establiment</span>
				</div>
				</div>
				
				<div class="bg-white/40 backdrop-blur-sm rounded-2xl p-5 flex items-center gap-4">
				<div class="w-14 h-14 bg-[#edd6b0] rounded-xl flex items-center justify-center text-3xl shadow-lg">🔌</div>
				<div>
					<span class="text-lg font-black text-[#2e241e] block">Endolls</span>
					<span class="text-sm text-[#2e241e]/70">a cada taula</span>
				</div>
				</div>
			</div>
		
			<!-- Informació addicional -->
			<div class="flex flex-wrap items-center justify-center gap-4 pt-4 border-t border-[#2e241e]/10">
				<div class="bg-[#2e241e] text-white px-6 py-3 rounded-full text-sm font-bold whitespace-nowrap">
				🎉 Brunch especial DS-DG
				</div>
			</div>
			</div>
		</div>

          <div class="lg:col-span-2 bg-[#cb9b7c] rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-12 flex flex-col md:flex-row justify-between items-center text-[#2e241e]">
            <div class="text-center md:text-left">
              <h3 class="font-serif text-3xl md:text-4xl mb-2">{especialitat[3].name}</h3>
              <p class="text-lg md:text-xl max-w-md mb-6">{especialitat[3].desc}</p>
              <div class="flex justify-center md:justify-start gap-2">
                {especialitat[3].tags?.map(tag => <span class="bg-white/40 px-4 py-1.5 rounded-full text-xs font-bold uppercase">{tag}</span>)}
              </div>
            </div>
            <span class="text-5xl md:text-6xl font-black mt-8 md:mt-0">{especialitat[3].price}</span>
          </div>

          <div class="bg-[#b6c9a0] rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-12 text-center flex flex-col items-center justify-center">
            <span class="text-6xl md:text-7xl block mb-4">🌱</span>
            <h3 class="font-serif text-3xl mb-2 leading-none">llets vegetals</h3>
            <p class="text-base md:text-xl">civada, ametlla, soja · sense cost extra</p>
          </div>
        </div>
      </section>

      <section id="espai" class="py-16 grid lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-12 shadow-xl border border-black/5">
          <div class="flex items-center gap-6 md:gap-8 mb-10 md:mb-12">
            <span class="text-5xl md:text-7xl font-black">4.9★</span>
            <span class="text-lg md:text-2xl text-gray-600">+200 opinions a Google</span>
          </div>
          <div class="space-y-6">
            {reviews.map(r => (
              <div class="bg-[#fcf9f0] border border-black/5 rounded-2xl md:rounded-3xl p-6 md:p-8">
                <div class="flex gap-1 text-xl md:text-2xl mb-4 text-[#cb9b7c]">{'★'.repeat(r.rating)}</div>
                <p class="text-lg md:text-xl italic leading-relaxed">“{r.quote}”</p>
                <p class="text-right font-bold mt-4 text-[#5f4e44]">— {r.name}</p>
              </div>
            ))}
          </div>
        </div>

		<!-- CARD INSTAGRAM/AMBIENT - VERSIÓ PREMIUM -->
		<div class="bg-gradient-to-br from-[#d6cdc0] to-[#c4b9aa] rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-14 shadow-2xl hover:shadow-3xl transition-all duration-300 relative overflow-hidden group min-h-[300px] md:min-h-[400px] flex flex-col justify-center items-center text-center">
		
			<!-- Elements decoratius de fons -->
			<div class="absolute top-0 left-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
			<div class="absolute bottom-0 right-0 w-80 h-80 bg-black/5 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>
			
			
			<!-- Contingut principal -->
			<div class="relative z-10 max-w-2xl mx-auto">			
			
			<!-- Frase principal amb més estil -->
			<p class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl mb-6 md:mb-8 leading-tight text-[#2e241e] relative">
				<span class="relative inline-block">
				“cafè, arrels
