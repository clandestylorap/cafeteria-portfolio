---
import '../styles/global.css'
import { Menu, X } from 'lucide-astro';

const menuPrimavera = [
  {
    title: "Iced Matcha amb Lavanda",
    description: "Matcha japonès batut a mà amb llet fresca i un toc de xarop casolà de lavanda. Refrescant, floral i profundament serè.",
    price: "5,90€",
    tags: ["Edició limitada", "Fred"],
    image_url: "images/menu_1.png",
  },
  {
    title: "Torrada de Pèsols i Menta",
    description: "Llesca de pagès torrada amb crema de pèsols tendres, menta fresca i oli d'oliva verge extra. Lluminosament verda i cruixent.",
    price: "8,20€",
    tags: ["Vegà", "Sense gluten"],
    image_url: "images/menu_2.png",
  },
  {
    title: "Bowl de Fruits del Bosc",
    description: "Barreja de gerds, nabius i mores amb iogurt cremós, granola torrada a la casa i mel de proximitat.",
    price: "7,90€",
    tags: ["Sense gluten", "Vegetarià"],
    image_url: "images/menu_3.png",
  }
];

const especialitat = [
  { name: "Espresso", price: "2,20€", desc: "Curt, intens i brillant. Extracció precisa per revelar cada matís del gra.", origin: "Etiòpia", notes: "cítric, florals", badge: "Preferit", image_url: "images/expresso.jpg" },
  { name: "Flat White", price: "3,50€", desc: "Doble espresso amb llet emulsionada sedosa. Equilibri perfecte entre cos i cremositat.", origin: "Colòmbia", notes: "xocolata, nous", badge: null, image_url: "images/flat_white.jpg" },
  { name: "Cold Brew", price: "4,00€", desc: "Infusionat en fred durant 16 hores. Dolç naturalment, sense pressa ni amargors.", origin: "Nicaragua", notes: "caramel, fruita", badge: "Preferit", image_url: "images/cold.jpg" },
  { name: "Torrada d'Alvocat", price: "8,50€", desc: "Pa de massa mare, alvocat madur, llavors torrades i llima fresca. El nostre clàssic de brunch.", origin: "Casa", notes: "vegà, sense gluten", badge: null, image_url: "https://images.unsplash.com/photo-1515041761709-f9fc96e04cd3?fm=jpg&q=60&w=800&auto=format&fit=crop&ixlib=rb-4.1.0" },
];

const reviews = [
  { quote: "Cada matí, el primer glop de cafè a MÖSSA em recorda que la ciutat també pot respirar amb calma.", name: "Laia", context: "veïna de Gràcia", rating: 5 },
  { quote: "És el lloc on el soroll queda fora i només entren els bons llibres i l'aroma de cafè acabat de moldre.", name: "Jordi", context: "treballador remot", rating: 5 },
  { quote: "Han convertit la pausa del cafè en un petit ritual diari. El personal et coneix pel nom i pel tipus de gra.", name: "Mar", context: "habitual de caps de setmana", rating: 5 },
];

const products = [...especialitat, ...menuPrimavera];

/* Galeria decorativa — URLs verificades d'Unsplash (format ixlib actual) */
const galeria = [
  "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
  "https://images.unsplash.com/photo-1511920170033-f8396924c348?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
  "https://images.unsplash.com/photo-1506619216599-9d16d0903dfd?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
  "https://images.unsplash.com/photo-1512568400610-62da28bc8a13?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
  "https://images.unsplash.com/photo-1502462041640-b3d7e50d0662?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
  "https://images.unsplash.com/photo-1485808191679-5f86510681a2?fm=jpg&q=60&w=500&auto=format&fit=crop&ixlib=rb-4.1.0",
];

/* Imatges decoratives verificades per seccions de layout */
const img = {
  hero: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&q=60&w=1600&auto=format&fit=crop&ixlib=rb-4.1.0",
  polaroidA: "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&q=60&w=700&auto=format&fit=crop&ixlib=rb-4.1.0",
  polaroidB: "https://images.unsplash.com/photo-1506372023823-741c83b836fe?fm=jpg&q=60&w=700&auto=format&fit=crop&ixlib=rb-4.1.0",
  cartaSide: "https://images.unsplash.com/photo-1610632380989-680fe40816c6?fm=jpg&q=60&w=900&auto=format&fit=crop&ixlib=rb-4.1.0",
  reviewsBg: "https://images.unsplash.com/photo-1506619216599-9d16d0903dfd?fm=jpg&q=60&w=1600&auto=format&fit=crop&ixlib=rb-4.1.0",
  splash: "https://images.unsplash.com/photo-1559496417-e7f25cb247f3?fm=jpg&q=60&w=900&auto=format&fit=crop&ixlib=rb-4.1.0",
  aboutA: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?fm=jpg&q=60&w=900&auto=format&fit=crop&ixlib=rb-4.1.0",
  aboutB: "https://images.unsplash.com/photo-1533776992670-a72f4c28235e?fm=jpg&q=60&w=900&auto=format&fit=crop&ixlib=rb-4.1.0",
  contacte: "images/ubication.jpg",
};
---

<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MÖSSA · Coffee & Roots | Cafè d'especialitat a Gràcia</title>
    <meta name="description" content="Cafè d'especialitat torrat a Gràcia. Torrada del mes, brunch de temporada i un espai on el temps s'alenteix." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cream text-ink font-body antialiased overflow-x-hidden">

    <!-- ============ HEADER ============ -->
    <header class="sticky top-0 z-50 bg-cream/95 backdrop-saturate-150 border-b border-ink/10 px-4 md:px-8">
      <div class="max-w-6xl mx-auto flex items-center justify-between h-16 md:h-20">
        <a href="/" class="flex items-center gap-2">
          <span class="font-display text-2xl md:text-3xl tracking-tight uppercase">MÖSSA</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold uppercase tracking-wide text-ink-soft">
          <a href="#cafe" class="hover:text-ink transition-colors duration-150">Cafè</a>
          <a href="#carta" class="hover:text-ink transition-colors duration-150">Carta</a>
          <a href="#espai" class="hover:text-ink transition-colors duration-150">Ressenyes</a>
          <a href="#contacte" class="hover:text-ink transition-colors duration-150">Visita'ns</a>
        </nav>

        <a href="#reserva" class="hidden md:inline-flex items-center bg-brown text-cream px-6 py-3 min-h-11 rounded-full text-sm font-semibold hover:bg-ink transition-colors duration-150">
          Reserva
        </a>

        <button id="menu-toggle" aria-label="Obre el menú" aria-expanded="false" class="md:hidden w-11 h-11 flex items-center justify-center cursor-pointer">
          <Menu id="icon-menu" class="w-6 h-6" />
          <X id="icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

      <div id="mobile-menu" class="md:hidden hidden border-t border-ink/10 py-6 flex flex-col gap-5 text-sm font-semibold uppercase tracking-wide text-ink-soft">
        <a href="#cafe" class="min-h-11 flex items-center">Cafè</a>
        <a href="#carta" class="min-h-11 flex items-center">Carta</a>
        <a href="#espai" class="min-h-11 flex items-center">Ressenyes</a>
        <a href="#contacte" class="min-h-11 flex items-center">Visita'ns</a>
        <a href="#reserva" class="min-h-11 flex items-center justify-center bg-brown text-cream rounded-full mt-2">Reserva</a>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="max-w-4xl mx-auto px-4 md:px-8 pt-14 md:pt-20 text-center">

        <h1 class="font-display uppercase leading-[0.92] tracking-tight" style="font-size: clamp(2.8rem, 9vw, 5.5rem);">
          El ritual de la calma<br />en cada tassa
        </h1>

        <p class="text-base md:text-lg text-ink-soft max-w-xl mx-auto mt-6 leading-relaxed">
          Cafè d'especialitat de temporada, brunch artesà i un refugi on el temps s'alenteix.
        </p>

        <a href="#reserva" class="min-h-11 inline-flex items-center justify-center bg-brown text-cream px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide mt-8 hover:bg-ink transition-colors duration-150">
          Reserva ara
        </a>
      </section>

      <div class="max-w-5xl mx-auto px-4 md:px-8 mt-10 md:mt-14">
        <div class="relative rounded-[2rem] md:rounded-[2.5rem] overflow-hidden">
          <img
            src={img.hero}
            alt="Cafè de MÖSSA servit sobre taula de fusta"
            class="w-full h-[280px] md:h-[440px] object-cover"
            loading="eager"
          />
        </div>
      </div>

<!-- ============ CREDENCIALS ============ -->
      <section class="max-w-6xl mx-auto px-4 md:px-8 mt-14 md:mt-20">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="border border-ink/10 p-5 md:p-6">
            <span class="font-display text-3xl md:text-4xl block leading-none">4,9</span>
            <span class="text-[11px] uppercase tracking-wide text-ink-soft mt-2 block">Google · 200+ opinions</span>
          </div>
          <div class="border border-ink/10 p-5 md:p-6">
            <span class="font-display text-3xl md:text-4xl block leading-none">150+</span>
            <span class="text-[11px] uppercase tracking-wide text-ink-soft mt-2 block">Clients habituals</span>
          </div>
          <div class="border border-ink/10 p-5 md:p-6">
            <span class="font-display text-3xl md:text-4xl block leading-none tracking-tight">DL–DG</span>
            <span class="text-[11px] uppercase tracking-wide text-ink-soft mt-2 block">Obert cada dia · Gràcia</span>
          </div>
          <div class="border border-ink/10 p-5 md:p-6">
            <span class="font-display text-3xl md:text-4xl block leading-none tracking-tight">Yirga.</span>
            <span class="text-[11px] uppercase tracking-wide text-ink-soft mt-2 block">Gra del mes · Etiòpia</span>
          </div>
        </div>
      </section>

      <!-- ============ CAFÈ SENSE CAP PRESSA ============ -->
      <section id="cafe" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-28 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="relative h-72 md:h-96 flex items-center justify-center">
          <img
            src={img.polaroidA}
            alt="Barista preparant un cafè amb llet"
            class="tilt-a absolute w-40 md:w-56 aspect-[3/4] object-cover rounded-2xl shadow-xl border-4 border-cream left-2 md:left-8 top-0"
            loading="lazy"
          />
          <img
            src={img.polaroidB}
            alt="Cafè servit a MÖSSA"
            class="tilt-b absolute w-40 md:w-56 aspect-[3/4] object-cover rounded-2xl shadow-xl border-4 border-cream right-2 md:right-8 bottom-0"
            loading="lazy"
          />
        </div>

        <div>
          <h2 class="font-display uppercase leading-[0.92] tracking-tight" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
            Cafè fet<br />sense cap pressa
          </h2>
          <p class="text-ink-soft leading-relaxed mt-6 max-w-md">
            Seleccionem el gra origen a origen, el torrem amb cura i el servim al punt. Cada tassa surt d'un procés pensat perquè la pausa valgui la pena — sense presses, sense dreceres.
          </p>
          <a href="#carta" class="inline-flex items-center gap-3 mt-8 font-semibold uppercase tracking-wide text-sm group">
            Veure la carta
            <span class="w-9 h-9 rounded-full bg-brown text-cream flex items-center justify-center group-hover:translate-x-1 transition-transform duration-200">→</span>
          </a>
        </div>
      </section>

      <!-- ============ LA CARTA ============ -->
      <section id="carta" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
        <div class="flex items-end justify-between gap-6 mb-10 md:mb-14">
          <h2 class="font-display uppercase leading-[0.92] tracking-tight" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
            La carta
          </h2>
          <span class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-ink-soft">
            Primavera · fins 21 juny
          </span>
        </div>

        <div class="grid lg:grid-cols-[1fr_1.4fr] gap-6 md:gap-8">
          <div class="rounded-[2rem] overflow-hidden h-72 lg:h-full">
            <img
              src={img.cartaSide}
              alt="Ambient de cafeteria"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
            {products.map(item => (
              <article class="bg-cream-2 rounded-[1.5rem] p-3 flex flex-col">
                <div class="relative rounded-2xl overflow-hidden aspect-[4/3] mb-4">
                  <img src={item.image_url} alt={item.name ?? item.title} class="w-full h-full object-cover" loading="lazy" />
                  {item.badge && (
                    <span class="absolute top-3 left-3 bg-cream text-ink text-[10px] font-semibold uppercase tracking-wide px-3 py-1.5 rounded-full">
                      {item.badge}
                    </span>
                  )}
                </div>
                <div class="px-2 pb-2 flex flex-col flex-grow">
                  <h3 class="font-display text-lg md:text-xl uppercase leading-tight mb-1">{item.name ?? item.title}</h3>
                  <p class="text-xs text-ink-soft leading-relaxed mb-3 line-clamp-2">{item.desc ?? item.description}</p>
                  <div class="flex items-center justify-between mt-auto pt-2">
                    <span class="font-display text-lg">{item.price}</span>
                    <a href="#reserva" aria-label={`Demana ${item.name ?? item.title}`} class="w-9 h-9 rounded-full bg-brown text-cream flex items-center justify-center hover:bg-ink transition-colors duration-150">→</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ RESSENYES (dark textured band) ============ -->
      <section id="espai" class="relative bg-brown text-cream py-16 md:py-24 overflow-hidden">
        <img
          src={img.reviewsBg}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover opacity-20"
        />
        <div class="relative max-w-6xl mx-auto px-4 md:px-8">
          <h2 class="font-display uppercase leading-[0.92] tracking-tight mb-10 md:mb-14" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
            Les ressenyes<br />parlen soles
          </h2>

          <div class="grid md:grid-cols-3 gap-5">
            {reviews.map(r => (
              <div class="bg-cream text-ink rounded-[1.5rem] p-6 md:p-7 flex flex-col">
                <div class="text-gold text-sm mb-4">{"★".repeat(r.rating)}</div>
                <p class="leading-relaxed flex-grow">"{r.quote}"</p>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft mt-6 pt-4 border-t border-ink/10">{r.name} — {r.context}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SPLASH / FEATURE ============ -->
      <section class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-28 grid md:grid-cols-2 gap-10 items-center">
        <div class="rounded-[2rem] overflow-hidden order-2 md:order-1">
          <img
            src={img.splash}
            alt="Cold brew de MÖSSA amb gel"
            class="w-full h-72 md:h-[420px] object-cover"
            loading="lazy"
          />
        </div>

        <div class="order-1 md:order-2">
          <h2 class="font-display uppercase leading-[0.92] tracking-tight mb-6" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
            Cafè de veritat,<br />per al dia a dia
          </h2>
          <p class="text-ink-soft leading-relaxed max-w-md mb-6">
            De l'espresso curt al cold brew de setze hores. Preparat al moment, pensat perquè el vulguis repetir cada dia.
          </p>
          <a href="#carta" class="inline-flex items-center justify-center bg-brown text-cream px-7 py-4 rounded-full text-sm font-semibold uppercase tracking-wide mb-8 hover:bg-ink transition-colors duration-150">
            Veure la carta
          </a>

          <div class="flex flex-wrap gap-2">
            {["Torrat cada dilluns", "Llets vegetals incloses", "Gra 100% seleccionat"].map(f => (
              <span class="inline-flex items-center gap-2 bg-cream-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wide">
                <span class="text-gold">✓</span>{f}
              </span>
            ))}
            {["Sense sabors artificials"].map(f => (
              <span class="inline-flex items-center gap-2 bg-cream-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wide">
                <span class="text-ink-soft/50">✕</span>{f}
              </span>
            ))}
          </div>
        </div>
      </section>

<!-- ============ ORIGEN / SOBRE NOSALTRES ============ -->
      <section class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
        <div class="grid md:grid-cols-[1fr_1.2fr] gap-8 md:gap-12 items-end">
          <div>
            <span class="text-[11px] uppercase tracking-wide text-ink-soft block mb-3">Sobre nosaltres</span>
            <h2 class="font-display uppercase leading-[0.92] tracking-tight mb-6" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">
              Un local petit,<br />un cafè honest
            </h2>
            <p class="text-ink-soft leading-relaxed mb-8 max-w-md">
              MÖSSA va néixer d'unes ganes grans de fer bé una sola cosa. Seguim triant el gra amb calma, el torrem nosaltres mateixos i obrim les portes cada dia perquè Gràcia tingui un racó on el temps s'alenteix.
            </p>
            <a href="#contacte" class="inline-flex items-center gap-3 font-semibold uppercase tracking-wide text-sm group">
              Visita'ns
              <span class="w-9 h-9 rounded-full bg-brown text-cream flex items-center justify-center group-hover:translate-x-1 transition-transform duration-200">→</span>
            </a>
          </div>

          <div class="grid grid-cols-5 gap-3">
            <div class="col-span-3 aspect-[3/4] rounded-2xl overflow-hidden">
              <img
                src={img.aboutA}
                alt="Clienta gaudint d'un cafè"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="col-span-2 aspect-[3/4] rounded-2xl overflow-hidden">
              <img
                src={img.aboutB}
                alt="Interior de MÖSSA a Gràcia"
                class="w-full h-full object-cover grayscale"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- ============ GALERIA ============ -->
      <section class="bg-brown py-10 md:py-14">
        <div class="flex items-center justify-between max-w-6xl mx-auto px-4 md:px-8 mb-6">
          <span class="text-cream font-display text-xl md:text-2xl uppercase">@mossa.coffee</span>
          <span class="text-cream/60 text-xs uppercase tracking-wide">2.500+ seguidors</span>
        </div>
        <div class="max-w-6xl mx-auto px-4 md:px-8 flex flex-wrap justify-center gap-2 md:gap-3">
          {galeria.map(src => (
            <img src={src} alt="Instantània de MÖSSA a Instagram" class="w-40 md:w-56 h-40 md:h-56 object-cover rounded-2xl" loading="lazy" />
          ))}
        </div>
      </section>

      <!-- ============ CONTACTE + RESERVA ============ -->
      <section id="contacte" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24 grid lg:grid-cols-2 gap-6 md:gap-8">
        <div class="bg-cream-2 rounded-[2rem] overflow-hidden flex flex-col">
          <div class="h-56 md:h-64 relative overflow-hidden">
            <img
              src={img.contacte}
              alt="Carrer de Gràcia, Barcelona"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <span class="absolute top-4 right-4 bg-brown text-cream text-xs font-semibold uppercase tracking-wide px-4 py-2 rounded-full">
              5 min de Fontana
            </span>
          </div>
          <div class="p-6 md:p-8 flex-grow">
            <h3 class="font-display text-2xl uppercase mb-2">Carrer de les Arrels, 27</h3>
            <p class="text-ink-soft text-sm leading-relaxed mb-6">
              Entre una llibreria independent i un taller d'artesania. Arriba en bici — tenim aparcament segur.
            </p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              {["Aparcament bici", "Parking a prop", "Accés adaptat", "Pet friendly"].map(f => (
                <span class="bg-cream rounded-xl px-3 py-3 text-xs font-semibold text-center">{f}</span>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="tel:+34600000000" class="min-h-11 flex-1 flex items-center justify-center bg-brown text-cream rounded-full text-sm font-semibold hover:bg-ink transition-colors duration-150">
                +34 600 000 000
              </a>
              <a href="mailto:hola@mossa.cat" class="min-h-11 flex-1 flex items-center justify-center border border-ink text-ink rounded-full text-sm font-semibold hover:bg-ink hover:text-cream transition-colors duration-150">
                hola@mossa.cat
              </a>
            </div>
          </div>
        </div>

        <div id="reserva" class="scroll-mt-16 bg-brown text-cream rounded-[2rem] p-8 md:p-10 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-3xl md:text-4xl uppercase leading-[0.95] mb-4">Reserva<br />taula</h3>
            <p class="text-cream/70 leading-relaxed">Escriu-nos per WhatsApp i et confirmem en minuts.</p>
          </div>

          <a href="https://wa.me/tu-numero"
            target="_blank"
            rel="noopener"
            class="min-h-11 mt-10 bg-cream text-ink px-6 py-5 rounded-full text-base font-semibold flex items-center justify-center gap-3 hover:bg-gold transition-colors duration-150">
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
